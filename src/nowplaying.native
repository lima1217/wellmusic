<!-- The now-playing transport bar. The rounded-square cover is the one
     image binding markup carries (the avatar's u64 ImageId). Playback is
     REAL audio through the runtime audio effect family — see model.zig.
     No seek scrubber: a progress bar would force frequent full-tree
     rebuilds while playing. Playback state is mirrored ~every 2s via
     `audio_poll`; Now Playing metadata updates inside that poll. The
     title/artist lines double as the status surface: a failed load swaps
     in the assets-not-prepared notice so the user knows what failed.

     Three equal-balance zones (Apple Music / Spotify convention):
       leading  — cover + title/artist (press: show the playing album)
       center   — prev / play-pause / next (play-pause on a neutral fill:
                  the page's one accent fill belongs to its own action,
                  e.g. Play Album, not to a bar that is always on screen)
       trailing — shuffle, repeat, mute + volume, always-visible queue toggle
     Matching grow on the leading and trailing rows keeps the transport
     optically mid-bar; utilities stay discoverable at the trailing edge.
     Uniform gaps inside each zone (no asymmetric prev↔play vs play↔next).
     Default (not sm) clears Geist's 40pt desktop hit-area floor.
     Chrome fill is applied by the Zig shell (`chromeBand`): layout
     row/column backgrounds do not paint. Cover uses radius md so it
     shares the library's rounded-square language (not a pill). -->
<column>
  <!-- No hairline above the transport: chrome-vs-page fill already
       separates the band (shadows-over-borders). -->
  <row height="80" padding="16" gap="16" cross="center" label="{strNowPlaying}">
    <!-- The leading zone is one hit target: it opens the playing album
         at the playing track. -->
    <row grow="1" gap="12" cross="center" on-press="reveal_now_playing" label="{strShowNowPlaying}">
      <avatar image="{nowPlayingCover}" width="48" height="48" radius="md">{nowPlayingInitials}</avatar>
      <column grow="1" gap="2">
        <text wrap="false">{nowPlayingTitle}</text>
        <text size="sm" wrap="false" foreground="text_muted">{nowPlayingArtist}</text>
      </column>
    </row>
    <row gap="8" cross="center" label="{strPlaybackControls}">
      <button variant="ghost" icon="skip-back" disabled="{idle}" on-press="prev_track" label="{strPreviousTrack}"></button>
      <button variant="secondary" icon="{playPauseIcon}" on-press="toggle_play" label="{strPlayOrPause}"></button>
      <button variant="ghost" icon="skip-forward" disabled="{idle}" on-press="next_track" label="{strNextTrack}"></button>
    </row>
    <!-- Shuffle and repeat are two controls (Apple Music's pair): each
         shows its own on/off state, so nothing has to be read off a
         cycling glyph. -->
    <row grow="1" gap="8" cross="center" main="end" label="{strPlaybackOptions}">
      <!-- On = accent icon. The theme gives a selected ghost button no
           visible fill, so state rides the ink instead; `foreground`
           only takes literal tokens, hence an <if> pair per control.
           Each icon-only control sits in a stack with an anchored
           tooltip naming its current state (the same text as its
           accessibility label). The runtime shows it on hover after the
           theme's delay, and instantly for a neighbour within the warm
           window, so sweeping along the row does not wait each time. -->
      <stack>
        <if test="{shuffle}">
          <button variant="ghost" icon="shuffle" foreground="accent" selected="true" on-press="toggle_shuffle" label="{shuffleLabel}"></button>
        </if>
        <if test="{shuffleOff}">
          <button variant="ghost" icon="shuffle" on-press="toggle_shuffle" label="{shuffleLabel}"></button>
        </if>
        <tooltip anchor="above">{shuffleLabel}</tooltip>
      </stack>
      <stack>
        <if test="{repeatActive}">
          <button variant="ghost" icon="{repeatIcon}" foreground="accent" selected="true" on-press="cycle_repeat" label="{repeatLabel}"></button>
        </if>
        <if test="{repeatOff}">
          <button variant="ghost" icon="{repeatIcon}" on-press="cycle_repeat" label="{repeatLabel}"></button>
        </if>
        <tooltip anchor="above">{repeatLabel}</tooltip>
      </stack>
      <row gap="2" cross="center" label="{strVolume}">
        <stack>
          <button size="sm" variant="ghost" icon="{volumeIcon}" on-press="toggle_mute" label="{muteLabel}"></button>
          <tooltip anchor="above">{muteLabel}</tooltip>
        </stack>
        <slider width="88" value="{volumeFraction}" on-change="volume_changed" label="{strVolume}" />
      </row>
      <stack>
        <button variant="ghost" icon="app:queue" selected="{queue_open}" on-press="toggle_queue" label="{strToggleQueue}"></button>
        <tooltip anchor="above">{strToggleQueue}</tooltip>
      </stack>
    </row>
  </row>
</column>
