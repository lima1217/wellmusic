<!-- The wellmusic header bar. Two trailing controls, both visible at all
     times: Add Music (+), the app's main way in, and the light/dark
     switch. Adding used to hide in a ⋯ overflow, where a first-time user
     with a non-empty library had no visible way to add more; the
     overflow held only three items, so it is gone. Compiled at comptime
     (canvas.CompiledMarkupView) and composed under the Zig root view.
     Chrome fill is applied by the Zig shell (`chromeBand`). -->
<column>
  <!-- The header IS the titlebar: the window's drag surface, leading
       spacer sized to the traffic lights via on_chrome. -->
  <row height="{header_height}" gap="4" cross="center" window-drag="true" label="WellMusic">
    <spacer width="{chrome_leading}" />
    <spacer grow="1" />
    <stack>
      <button size="sm" variant="ghost" icon="plus" selected="{header_menu_open}" on-press="toggle_header_menu" label="{strAddMusic}"></button>
      <if test="{header_menu_open}">
        <dropdown-menu anchor="below" anchor-alignment="end" anchor-offset="4" on-dismiss="close_header_menu">
          <menu-item icon="music" on-press="add_music">{strAddSong}</menu-item>
          <menu-item icon="folder" on-press="import_album">{strAddAlbum}</menu-item>
        </dropdown-menu>
      </if>
      <tooltip anchor="below">{strAddMusic}</tooltip>
    </stack>
    <stack>
      <button size="sm" variant="ghost" icon="{themeIcon}" on-press="toggle_theme" label="{themeLabel}"></button>
      <tooltip anchor="below">{themeLabel}</tooltip>
    </stack>
    <spacer width="{chrome_trailing}" />
    <spacer width="8" />
  </row>
</column>
